@model Infrastructure.ViewModel.CategoryViewModel

@{
    ViewData["Title"] = "إضافة قسم جديد - Add Category";
}

<div class="container-sm d-flex justify-content-center mt-5">
    <div class="col-12 col-md-8 col-lg-6 card border-0 shadow-sm p-4 p-md-5" style="border-radius: var(--radius, 14px); background: #fff;">
        <div class="text-center mb-4">
            <h2 class="h3 fw-bold" style="font-family: 'El Messiri', serif; color: var(--pine);">إضافة قسم جديد</h2>
            <p class="text-muted small">أدخل اسم القسم الجديد لإضافته إلى المتجر</p>
        </div>

        <form asp-controller="Category" asp-action="AddCategory" method="post">
            <div class="form-group mb-4">
                <label asp-for="CategoryName" class="form-label fw-semibold mb-2">اسم القسم</label>
                <input asp-for="CategoryName" class="form-control form-control-lg" placeholder="مثال: ملابس صيفية، أحذية..." required />
                <span asp-validation-for="CategoryName" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="CategoryNameInArabic" class="form-label fw-semibold mb-2"> اسم القسم بالعربي</label>
                <input asp-for="CategoryNameInArabic" class="form-control form-control-lg" placeholder="مثال: ملابس صيفية، أحذية..." required />
                <span asp-validation-for="CategoryNameInArabic" class="text-danger small"></span>
            </div>

            <div class="d-flex flex-column gap-2 mt-4">
                <button class="btn btn-primary btn-lg w-100" type="submit" style="background-color: var(--pine); border-color: var(--pine); border-radius: 8px; font-weight: 600;">
                    + إضافة القسم (Add Category)
                </button>
                <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary w-100" style="border-radius: 8px;">
                    العودة لقائمة الأقسام (Back to Categories)
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}