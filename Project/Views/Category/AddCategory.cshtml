@model Infrastructure.ViewModel.CategoryViewModel;


@{
    ViewData["Title"] = "Add Category";


}
<div class="container-sm d-flex justify-content-center mt-4 ">
    <div class="col-10 Addbookform">
        <h1 class="text-center">Add New Category</h1>
        <div>
            <form asp-controller="Category" asp-action="AddCategory" method="post" enctype="multipart/form-data">

                <div class="form-group  mb-3 ">
                    <label asp-for="CategoryName" class="control-label ms-1">Name </label>
                    <input asp-for="CategoryName" class="form-control" aria-required="true" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>
                <button class="btn btn-primary w-100 mt-4 " type="submit">Add Book</button>
            </form>
        </div>

        <div class="mt-2">
            <a asp-controller="Home" asp-action="Index" class="">Back to Home</a>
        </div>
    </div>

</div>