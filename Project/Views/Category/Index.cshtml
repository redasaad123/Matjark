@model IEnumerable<Infrastructure.ViewModel.CategoryViewModel>

@{
    ViewData["Title"] = "الأقسام - Categories";
}

<div class="container py-4">
    <!-- Header Section with Title and Add Category Button -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h2 mb-1" style="font-family: 'El Messiri', serif; color: var(--pine);">إدارة الأقسام</h1>
            <p class="text-muted mb-0">عرض وإدارة جميع الأقسام المتاحة في المتجر</p>
        </div>
        <div class="mt-2 mt-sm-0">
            <a asp-controller="Category" asp-action="AddCategory" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2" style="background-color: var(--pine); border-color: var(--pine); color: #fff;border-radius: 8px; font-weight: 600;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>إضافة قسم جديد (Add Category)</span>
            </a>
        </div>
    </div>

    <!-- Categories List Card -->
    <div class="card border-0 shadow-sm" style="border-radius: var(--radius, 14px); overflow: hidden; background: #fff;">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8f9fa; border-bottom: 2px solid var(--line, #d8cfb8);">
                        <tr>
                            <th class="py-3 px-4 text-secondary" style="width: 80px;">#</th>
                            <th class="py-3 px-4 text-secondary">اسم القسم (Category Name)</th>
                            <th class="py-3 px-4 text-center text-secondary" style="width: 220px;">الإجراءات (Actions)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 1;
                        }
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td class="px-4 py-3 text-muted fw-bold">@(index++)</td>
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: var(--paper-2, #e7e0cf); color: var(--pine, #1f2a24); font-weight: bold;">
                                            @(string.IsNullOrEmpty(category.CategoryName) ? "?" : category.CategoryName.Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="fw-semibold fs-6" style="color: var(--ink, #20261f);">@category.CategoryName</span>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: var(--paper-2, #e7e0cf); color: var(--pine, #1f2a24); font-weight: bold;">
                                            @(string.IsNullOrEmpty(category.CategoryNameInArabic) ? "?" : category.CategoryNameInArabic.Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="fw-semibold fs-6" style="color: var(--ink, #20261f);">@category.CategoryNameInArabic</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-2">
                                        <!-- Update Button -->
                                        <a asp-controller="Category" asp-action="Edit" asp-route-id="@category.Id" 
                                           class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1 px-3 py-1.5"
                                           style="border-radius: 6px; font-weight: 500;"
                                           title="تعديل">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                            <span>Update</span>
                                        </a>

                                        <!-- Delete Button with Form -->
                                        <form asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف قسم &quot;@category.CategoryName&quot;؟');">
                                            <button type="submit" 
                                                    class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 px-3 py-1.5"
                                                    style="border-radius: 6px; font-weight: 500;"
                                                    title="حذف">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                                </svg>
                                                <span>Delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 px-3">
                <div class="mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                </div>
                <h4 class="fw-bold mb-2">لا توجد أقسام حتى الآن</h4>
                <p class="text-muted mb-4">ابدأ بإضافة أول قسم في متجرك لتنظيم المنتجات بسهولة.</p>
                <a asp-controller="Category" asp-action="AddCategory" class="btn btn-primary px-4 py-2" style="background-color: var(--pine); border-color: var(--pine); border-radius: 8px;">
                    + إضافة قسم جديد الآن
                </a>
            </div>
        }
    </div>
</div>
