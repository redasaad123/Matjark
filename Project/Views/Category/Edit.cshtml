@model Infrastructure.ViewModel.CategoryViewModel

@{
    ViewData["Title"] = "تعديل القسم - Edit Category";
}

<div class="container-sm d-flex justify-content-center mt-5">
    <div class="col-12 col-md-8 col-lg-6 card border-0 shadow-sm p-4 p-md-5" style="border-radius: var(--radius, 14px); background: #fff;">
        <div class="text-center mb-4">
            <h2 class="h3 fw-bold" style="font-family: 'El Messiri', serif; color: var(--pine);">تعديل القسم</h2>
            <p class="text-muted small">قم بتعديل بيانات القسم وحفظ التغييرات</p>
        </div>

        <form asp-controller="Category" asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-4">
                <label asp-for="CategoryName" class="form-label fw-semibold mb-2">اسم القسم (Category Name)</label>
                <input asp-for="CategoryName" class="form-control form-control-lg" placeholder="أدخل اسم القسم الجديد" required />
                <span asp-validation-for="CategoryName" class="text-danger small"></span>
            </div>

            <div class="d-flex flex-column gap-2 mt-4">
                <button class="btn btn-primary btn-lg w-100" type="submit" style="color: #fff;background-color: var(--pine); border-color: var(--pine); border-radius: 8px; font-weight: 600;">
                    حفظ التعديلات (Save Changes)
                </button>
                <a asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary w-100" style="border-radius: 8px;">
                    إلغاء والعودة للأقسام (Cancel)
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
