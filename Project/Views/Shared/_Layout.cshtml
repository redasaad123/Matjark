<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Project</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Project.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=El+Messiri:wght@500;600;700&family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="site">
        <div class="header-inner">
            <button class="icon-btn burger" id="burgerBtn" aria-label="القائمة"><svg><use href="#ic-menu" /></svg></button>
            <a href="#" class="logo"><svg class="mark"><use href="#ic-hanger" /></svg> زي</a>
            <nav class="main-nav" id="mainNav">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="shop" asp-route-filter="hero" >الرئيسية</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="shop" asp-route-filter="man">رجالي</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="shop" asp-route-filter="women" >حريمي</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="shop" asp-route-filter="accessories">إكسسوارات</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="shop" asp-route-filter="sale">تخفيضات</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <button class="icon-btn" id="cartBtn" aria-label="فتح السلة">
                    <svg><use href="#ic-cart" /></svg>
                    <span class="cart-badge" id="cartBadge">0</span>
                </button>
            </div>
        </div>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
            <symbol id="ic-hanger" viewBox="0 0 100 100"><path d="M50 20a7 7 0 1 1 -6 10 M50 30v8 M50 38 L15 62 A6 6 0 0 0 18 73 L82 73 A6 6 0 0 0 85 62 Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></symbol>
            <symbol id="ic-tshirt" viewBox="0 0 100 100"><path d="M20 26 L37 14 Q50 24 63 14 L80 26 L71 42 L64 36 L64 87 L36 87 L36 36 L29 42 Z" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" /></symbol>
            <symbol id="ic-jacket" viewBox="0 0 100 100"><path d="M20 28 L36 15 Q50 26 64 15 L80 28 L71 44 L64 37 L64 87 L36 87 L36 37 L29 44 Z" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" /><path d="M42 20 L47 87 M58 20 L53 87" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></symbol>
            <symbol id="ic-hoodie" viewBox="0 0 100 100"><path d="M50 10 Q34 10 32 26 L20 30 L28 46 L34 41 L34 88 L66 88 L66 41 L72 46 L80 30 L68 26 Q66 10 50 10 Z" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" /><circle cx="45" cy="34" r="1.8" fill="currentColor" /><circle cx="55" cy="34" r="1.8" fill="currentColor" /></symbol>
            <symbol id="ic-trousers" viewBox="0 0 100 100"><path d="M33 14 L67 14 L70 88 L57 88 L50 42 L43 88 L30 88 Z" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" /><path d="M33 14 L67 14" stroke="currentColor" stroke-width="4.5" /></symbol>
            <symbol id="ic-dress" viewBox="0 0 100 100"><path d="M36 12 L64 12 L60 40 L82 88 L18 88 L40 40 Z" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" /></symbol>
            <symbol id="ic-coat" viewBox="0 0 100 100"><path d="M22 26 L37 13 Q50 24 63 13 L78 26 L70 40 L64 34 L64 90 L36 90 L36 34 L30 40 Z" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" /><path d="M50 40 L50 90 M40 62 L60 62" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></symbol>
            <symbol id="ic-sweater" viewBox="0 0 100 100"><path d="M20 28 L37 15 L50 30 L63 15 L80 28 L71 44 L64 37 L64 87 L36 87 L36 37 L29 44 Z" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" /><path d="M36 80 L64 80 M36 74 L64 74" stroke="currentColor" stroke-width="2" opacity=".6" /></symbol>
            <symbol id="ic-shirt" viewBox="0 0 100 100"><path d="M20 26 L37 14 L44 22 L50 16 L56 22 L63 14 L80 26 L71 42 L64 36 L64 87 L36 87 L36 36 L29 42 Z" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" /><circle cx="50" cy="46" r="1.6" fill="currentColor" /><circle cx="50" cy="56" r="1.6" fill="currentColor" /><circle cx="50" cy="66" r="1.6" fill="currentColor" /></symbol>
            <symbol id="ic-bag" viewBox="0 0 100 100"><path d="M22 40 Q22 20 50 20 Q78 20 78 40" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" /><rect x="18" y="38" width="64" height="46" rx="8" fill="none" stroke="currentColor" stroke-width="4.5" /><path d="M18 54 L82 54" stroke="currentColor" stroke-width="2" opacity=".5" /></symbol>
            <symbol id="ic-cap" viewBox="0 0 100 100"><path d="M18 58 Q18 26 50 26 Q82 26 82 58" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" /><path d="M14 58 Q50 70 86 58" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" /><circle cx="50" cy="24" r="2.5" fill="currentColor" /></symbol>
            <symbol id="ic-cart" viewBox="0 0 24 24"><path d="M3 4h2l2.4 12.2A2 2 0 0 0 9.36 18H18a2 2 0 0 0 1.96-1.6L21.5 8H6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /><circle cx="9.5" cy="21" r="1.4" fill="currentColor" /><circle cx="18" cy="21" r="1.4" fill="currentColor" /></symbol>
            <symbol id="ic-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M20 20l-4.3-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
            <symbol id="ic-close" viewBox="0 0 24 24"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
            <symbol id="ic-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></symbol>
            <symbol id="ic-check" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></symbol>
            <symbol id="ic-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></symbol>
            <symbol id="ic-empty-cart" viewBox="0 0 24 24"><path d="M3 4h2l2.4 12.2A2 2 0 0 0 9.36 18H18a2 2 0 0 0 1.96-1.6L21.5 8H6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><circle cx="9.5" cy="21" r="1.2" fill="currentColor" /><circle cx="18" cy="21" r="1.2" fill="currentColor" /></symbol>
            <symbol id="ic-ig" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></symbol>
            <symbol id="ic-tw" viewBox="0 0 24 24"><path d="M22 5.9c-.7.3-1.5.5-2.3.6.8-.5 1.4-1.3 1.7-2.3-.8.5-1.6.8-2.6 1a4 4 0 0 0-6.9 3.7A11.5 11.5 0 0 1 3.5 4.6a4.1 4.1 0 0 0 1.3 5.4c-.6 0-1.2-.2-1.7-.5v.1c0 2 1.4 3.6 3.2 4a4 4 0 0 1-1.8.1 4 4 0 0 0 3.8 2.8A8.1 8.1 0 0 1 2 18.4a11.5 11.5 0 0 0 6.2 1.8c7.4 0 11.5-6.2 11.5-11.5v-.5c.8-.6 1.5-1.3 2.3-2.3z" fill="currentColor" /></symbol>
            <symbol id="ic-pin" viewBox="0 0 24 24"><path d="M12 21s7-6.3 7-11.5A7 7 0 0 0 5 9.5C5 14.7 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="9.5" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6" /></symbol>
        </defs>
    </svg>

    <!-- ============ CART DRAWER ============ -->
    <div class="overlay" id="overlay"></div>
    <aside class="cart-drawer" id="cartDrawer" aria-label="سلة المشتريات">
        <div class="cart-head">
            <h2>سلتك</h2>
            <button class="close-btn" id="closeCart" aria-label="اغلاق"><svg><use href="#ic-close" /></svg></button>
        </div>
        <div class="cart-items" id="cartItems"></div>
        <div class="cart-foot" id="cartFoot">
            <div class="sum-row"><span>المجموع الفرعي</span><span id="sumSubtotal">٠ ج.م</span></div>
            <div class="sum-row"><span>الشحن</span><span id="sumShipping">مجاني</span></div>
            <div class="sum-row total"><span>الإجمالي</span><span id="sumTotal">٠ ج.م</span></div>
            <button class="btn checkout-btn" id="checkoutBtn">إتمام الشراء</button>
        </div>
    </aside>

    <!-- ============ CHECKOUT MODAL ============ -->
    <div class="modal-overlay" id="modalOverlay">
        <div class="modal-box">
            <!-- ===== FORM STAGE ===== -->
            <div id="modalFormStage" class="modal-stage">
                <h3>تأكيد الطلب</h3>
                
                <!-- Order Items -->
                <div class="modal-order-items">
                    <h4>ملخص الطلب</h4>
                    <div id="modalOrderList"></div>
                </div>
                
                <!-- Customer Form -->
                <form id="orderForm" class="modal-form">
                    <div class="form-group">
                        <label for="customerName">الاسم</label>
                        <input type="text" id="customerName" name="name" required placeholder="أدخل اسمك">
                    </div>
                    
                    <div class="form-group">
                        <label for="customerEmail">البريد الإلكتروني</label>
                        <input type="email" id="customerEmail" name="email" required placeholder="your@email.com">
                    </div>
                    
                    <div class="form-group">
                        <label for="customerPhone">رقم الهاتف</label>
                        <input type="tel" id="customerPhone" name="phone" required placeholder="01xxxxxxxxx">
                    </div>
                    
                    <div class="form-group">
                        <label for="customerAddress">العنوان</label>
                        <textarea id="customerAddress" name="address" required placeholder="أدخل عنوان التوصيل" rows="3"></textarea>
                    </div>
                    
                    <div class="modal-total">
                        <span>الإجمالي</span>
                        <span id="modalTotal">٠ ج.م</span>
                    </div>
                    
                    <div class="modal-actions">
                        <button type="button" class="btn ghost" id="modalCancelBtn">إلغاء</button>
                        <button type="submit" class="btn" id="modalConfirmBtn">تأكيد الطلب</button>
                    </div>
                </form>
            </div>
            
            <!-- ===== SUCCESS STAGE ===== -->
            <div id="modalSuccessStage" class="modal-stage" style="display:none;">
                <div class="check-circle"><svg><use href="#ic-check" /></svg></div>
                <h3>تم استلام طلبك!</h3>
                <p>هيوصلك تأكيد على بريدك الإلكتروني، وهيتشحن طلبك خلال ٣-٥ أيام عمل.</p>
                <button class="btn" id="modalCloseBtn" style="width:100%;">تمام، يلا نكمل تسوق</button>
            </div>
        </div>
    </div>

    <div class="toast-wrap" id="toastWrap"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
