@model IEnumerable<Infrastructure.ViewModel.ProductViewModel>

@{
    ViewData["Title"] = "المنتجات - Products";
}

<div class="container py-4">
    <!-- Header Section with Title and Add Product Button -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h2 mb-1" style="font-family: 'El Messiri', serif; color: var(--pine);">إدارة المنتجات</h1>
            <p class="text-muted mb-0">عرض وإدارة جميع المنتجات المتاحة في المتجر</p>
        </div>
        <div class="mt-2 mt-sm-0">
            <a asp-controller="Manage" asp-action="AddProducts" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 py-2" style="background-color: var(--pine); border-color: var(--pine);color: #fff; border-radius: 8px; font-weight: 600;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <span>إضافة منتج جديد (Add Product)</span>
            </a>
        </div>
    </div>

    <!-- Products List Card / Table -->
    <div class="card border-0 shadow-sm" style="border-radius: var(--radius, 14px); overflow: hidden; background: #fff;">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8f9fa; border-bottom: 2px solid var(--line, #d8cfb8);">
                        <tr>
                            <th class="py-3 px-3 text-secondary" style="width: 60px;">#</th>
                            <th class="py-3 px-3 text-secondary" style="width: 90px;">الصورة</th>
                            <th class="py-3 px-4 text-secondary">اسم المنتج (Product Name)</th>
                            <th class="py-3 px-3 text-secondary">القسم (Category)</th>
                            <th class="py-3 px-3 text-secondary">السعر (Price)</th>
                            <th class="py-3 px-3 text-secondary">الكمية (Qty)</th>
                            <th class="py-3 px-4 text-center text-secondary" style="width: 220px;">الإجراءات (Actions)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = 1;
                        }
                        @foreach (var product in Model)
                        {
                            var img = product.GetImages != null && product.GetImages.Any() ? product.GetImages.First() : null;
                            var getProduct = product as Infrastructure.ViewModel.GetProductViewModel;
                            decimal? displayPrice = getProduct?.Price ?? product.OldPrice;
                            <tr>
                                <td class="px-3 py-3 text-muted fw-bold">@(index++)</td>
                                <td class="px-3 py-3">
                                    <div class="rounded overflow-hidden d-flex align-items-center justify-content-center" style="width: 55px; height: 55px; background: #f1f3f5; border: 1px solid #e9ecef;">
                                        @if (!string.IsNullOrEmpty(img))
                                        {
                                            <img src="/Images/@img" alt="@product.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
                                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                                <polyline points="21 15 16 10 5 21"></polyline>
                                            </svg>
                                        }
                                    </div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="fw-semibold fs-6" style="color: var(--ink, #20261f);">@product.Name</div>
                                    @if (!string.IsNullOrEmpty(product.Description))
                                    {
                                        <small class="text-muted d-block text-truncate" style="max-width: 280px;">@product.Description</small>
                                    }
                                </td>
                                <td class="px-3 py-3">
                                    <span class="badge px-2 py-1" style="background-color: var(--paper-2, #e7e0cf); color: var(--pine, #1f2a24); font-size: 0.85rem; font-weight: 500;">
                                        @(string.IsNullOrEmpty(product.Cat) ? "عام" : product.Cat)
                                    </span>
                                </td>
                                <td class="px-3 py-3">
                                    @if (product.IsDiscounted && product.OldPrice.HasValue)
                                    {
                                        <div>
                                            <span class="fw-bold text-success fs-6">@displayPrice?.ToString("0.00") ج.م</span>
                                            <small class="text-muted text-decoration-line-through d-block">@product.OldPrice?.ToString("0.00") ج.م</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="fw-bold fs-6" style="color: var(--pine, #1f2a24);">@product.OldPrice?.ToString("0.00") ج.م</span>
                                    }
                                </td>
                                <td class="px-3 py-3">
                                    @if (product.Quantity > 0)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">@product.Quantity قطعة</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">نفذت الكمية</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-2">
                                        <!-- Update Button -->
                                        <a asp-controller="Manage" asp-action="EditProducts" asp-route-id="@product.Id" 
                                           class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1 px-3 py-1.5"
                                           style="border-radius: 6px; font-weight: 500;"
                                           title="تعديل">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                            <span>Update</span>
                                        </a>

                                        <!-- Delete Button with Form -->
                                        <form asp-controller="Manage" asp-action="DeleteProduct" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف المنتج &quot;@product.Name&quot;؟');">
                                            <button type="submit" 
                                                    class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 px-3 py-1.5"
                                                    style="border-radius: 6px; font-weight: 500;"
                                                    title="حذف">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                                </svg>
                                                <span>Delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 px-3">
                <div class="mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                </div>
                <h4 class="fw-bold mb-2">لا توجد منتجات حتى الآن</h4>
                <p class="text-muted mb-4">ابدأ بإضافة أول منتج في متجرك لتبدأ في عرضه للعملاء.</p>
                <a asp-controller="Manage" asp-action="AddProducts" class="btn btn-primary px-4 py-2" style="background-color: var(--pine); border-color: var(--pine); border-radius: 8px;">
                    + إضافة منتج جديد الآن
                </a>
            </div>
        }
    </div>
</div>
