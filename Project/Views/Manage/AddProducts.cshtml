@model Infrastructure.ViewModel.AddProductViewModel;

@{
    ViewData["Title"] = "Add Book";
    

}
<div class="container-sm d-flex justify-content-center mt-4 ">
    <div class="col-10 Addbookform">
        <h1 class="text-center">Add New Product</h1>
        <div>
            <form asp-controller="Manage" asp-action="AddProducts" method="post" enctype="multipart/form-data">

                <div class="form-group  mb-3 ">
                    <label asp-for="Name" class="control-label ms-1">Name </label>
                    <input asp-for="Name" class="form-control" aria-required="true" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group d-md-flex">

                    <div class="form-group col-md-6 pe-md-2 mb-3">
                        <label asp-for="Cat" class="control-label ms-1">
                            Category
                        </label>

                        <select asp-for="Cat" class="form-control">
                            <option value="">-- Choose Category --</option>
                            @{
                                foreach (var cat in ViewBag.Category)
                                {
                                    <option value="@cat.Id">@cat.CategoryName</option>
                                }
                            }
                        </select>

                        <span asp-validation-for="Cat" class="text-danger"></span>
                    </div>

                    <div class="form-group  col-md-6 ps-md-2 mb-3">
                        <label asp-for="Quantity" class="control-label ms-1">Quantity </label>
                        <input asp-for="Quantity" class="form-control " aria-required="true" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>



                </div>

                <div class="form-group mb-3">
                    <label class="control-label ms-1">Available Sizes</label>

                    <div class="d-flex flex-wrap gap-2 mt-2">

                        @foreach (var size in ViewBag.Sizes)
                        {
                            <input type="checkbox"
                                   class="btn-check"
                                   name="Sizes"
                                   value="@size"
                                   id="size_@size">

                            <label class="btn btn-outline-primary"
                                   for="size_@size">
                                @size
                            </label>
                        }
                    </div>
                </div>

                @* <div class="d-md-flex">
                    <div class="form-group  col-md-6 pe-md-2 mb-3">
                        <label asp-for="DiscountPercentage" class="control-label ms-1"> Number Of Page</label>
                        <input asp-for="DiscountPercentage" class="form-control" aria-required="true" />
                        <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                    </div>

                    <div class="form-group  col-md-6 ps-md-2  mb-3">
                        <label asp-for="Gender" class="control-label ms-1"> Release Years</label>
                        <input asp-for="Gender" class="form-control" aria-required="true" />
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                </div> *@


                <div class="form-group mb-3">

                    <label class="control-label">Photo</label>

                    <div id="imagesContainer">
                        <div class="image-input mb-2">
                            <div class="d-flex gap-2">
                                <input type="file"
                                       name="Images"
                                       accept="image/*"
                                       class="form-control" />
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            id="addImage"
                            class="btn btn-secondary mt-2">
                        + Add Image
                    </button>

                </div>

                @* <div class="form-group mb-3">
                    <label asp-for="Price" class="control-label ">PDF</label>
                    <input asp-for="Price" type="file" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div> *@



                <div class="d-md-flex">
                    <div class="form-group  col-md-6 pe-md-2 mb-3">
                        <label asp-for="OldPrice" class="control-label ms-1">Price</label>
                        <input asp-for="OldPrice" class="form-control" aria-required="true" />
                        <span asp-validation-for="OldPrice" class="text-danger"></span>
                    </div>

                    <div class="d-md-flex col-md-6 ps-md-2 mt-4 mb-3">
                        <div class="form-check mb-3 me-3">
                            <input type="checkbox" class="form-check-input" asp-for="IsDiscounted" data-bs-toggle="collapse" data-bs-target="#collapseOffer" aria-expanded="false" aria-controls="collapseOffer" />
                            <label class="form-check-label" asp-for="IsDiscounted">Offer</label>
                        </div>


                        <div class="collapse  " id="collapseOffer">
                            <div class="card card-body pricecard">
                                <div class="form-group  ">
                                    <label asp-for="DiscountPercentage" class="control-label ms-1 ">Discount</label>
                                    <input asp-for="DiscountPercentage" class="form-control " />
                                    <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-md-12  ">
                    <label asp-for="Description" class="control-label ">Description</label>
                    <textarea class="form-control " asp-for="Description" name="Description" rows="6"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <button class="btn btn-primary w-100 mt-4 " type="submit">Add Book</button>
            </form>
        </div>

        <div class="mt-2">
            <a asp-controller="Home" asp-action="Index" class="">Back to Home</a>
        </div>
    </div>

</div>

<script>
    document.getElementById("addImage").addEventListener("click", function () {

        const container = document.getElementById("imagesContainer");

        const div = document.createElement("div");

        div.classList.add("image-input", "mb-2");

        div.innerHTML = `
            <div class="d-flex gap-2">

                <input type="file"
                       name="Images"
                       accept="image/*"
                       class="form-control" />

                <button type="button"
                        class="btn btn-danger remove-image">
                    X
                </button>

            </div>
        `;

        container.appendChild(div);
    });


    document.addEventListener("click", function (e) {

        if (e.target.classList.contains("remove-image")) {

            const imageInput = e.target.closest(".image-input");

            imageInput.remove();
        }

    });
</script>