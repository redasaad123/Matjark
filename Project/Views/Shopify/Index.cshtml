@{
    ViewData["Title"] = "تكامل Shopify";
    bool isConnected = ViewBag.IsConnected ?? false;
}

<div class="wrap" style="padding: 40px 20px; max-width: 900px; margin: 0 auto;">
    <div style="background: #ffffff; border-radius: 16px; padding: 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 1px solid #eaeaea;">
        
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; border-bottom: 1px solid #f0f0f0; padding-bottom: 16px;">
            <div>
                <h1 style="margin: 0; font-size: 1.8rem; font-weight: 700; color: #111;">إدارة ربط Shopify</h1>
                <p style="margin: 4px 0 0; color: #666; font-size: 0.95rem;">مزامنة المنتجات، الطلبات، والمخزون مع متجر شوبيفاي</p>
            </div>
            <div>
                @if (isConnected)
                {
                    <span style="background: #e6f4ea; color: #137333; padding: 8px 16px; border-radius: 20px; font-weight: 600; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 6px;">
                        ● متصل متجر Shopify
                    </span>
                }
                else
                {
                    <span style="background: #fce8e6; color: #c5221f; padding: 8px 16px; border-radius: 20px; font-weight: 600; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 6px;">
                        ✕ غير متصل (تحقق من البيانات في appsettings.json)
                    </span>
                }
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background: #e6f4ea; border-right: 4px solid #137333; color: #137333; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div style="background: #fce8e6; border-right: 4px solid #c5221f; color: #c5221f; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
                @TempData["ErrorMessage"]
            </div>
        }

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: 24px;">
            
            <!-- Sync Products Card -->
            <div style="background: #fdfdfd; border: 1px solid #e0e0e0; border-radius: 12px; padding: 20px; text-align: center;">
                <div style="font-size: 2.5rem; margin-bottom: 8px;">🛍️</div>
                <h3 style="margin: 0 0 8px; font-size: 1.2rem;">مزامنة المنتجات</h3>
                <p style="color: #666; font-size: 0.88rem; margin-bottom: 16px;">استيراد المنتجات والأسعار والمخزون من متجر Shopify إلى Matgark.</p>
                <form asp-action="SyncProducts" method="post">
                    <button type="submit" class="btn" style="width: 100%; justify-content: center;" @(isConnected ? "" : "disabled")>
                        بدء استيراد المنتجات
                    </button>
                </form>
            </div>

            <!-- Sync Orders Card -->
            <div style="background: #fdfdfd; border: 1px solid #e0e0e0; border-radius: 12px; padding: 20px; text-align: center;">
                <div style="font-size: 2.5rem; margin-bottom: 8px;">📦</div>
                <h3 style="margin: 0 0 8px; font-size: 1.2rem;">مزامنة الطلبات</h3>
                <p style="color: #666; font-size: 0.88rem; margin-bottom: 16px;">جلب جميع طلبات العملاء من Shopify وحفظها في قاعدة البيانات المحلية.</p>
                <form asp-action="SyncOrders" method="post">
                    <button type="submit" class="btn" style="width: 100%; justify-content: center;" @(isConnected ? "" : "disabled")>
                        بدء استيراد الطلبات
                    </button>
                </form>
            </div>

        </div>

        <!-- Webhook Info Box -->
        <div style="margin-top: 32px; background: #f8f9fa; border-radius: 12px; padding: 20px; border: 1px solid #eeeeee;">
            <h4 style="margin: 0 0 8px; font-size: 1.05rem; color: #333;">🔗 رابط استقبال Webhook (الإشعارات اللحظية)</h4>
            <p style="margin: 0 0 12px; color: #666; font-size: 0.88rem;">
                لربط المزامنة التلقائية مع Shopify، قم بإضافة رابط الـ Webhook التالي في إعدادات Notifications داخل Shopify Admin:
            </p>
            <code style="display: block; background: #ffffff; border: 1px solid #ddd; padding: 10px 14px; border-radius: 6px; font-family: monospace; font-size: 0.9rem; color: #2b579a; direction: ltr; text-align: left;">
                https://YOUR_DOMAIN.com/api/shopify/webhooks
            </code>
        </div>

    </div>
</div>
