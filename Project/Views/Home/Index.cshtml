        <symbol id="ic-sweater" viewBox="0 0 100 100"><path d="M20 28 L37 15 L50 30 L63 15 L80 28 L71 44 L64 37 L64 87 L36 87 L36 37 L29 44 Z" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round" /><path d="M36 80 L64 80 M36 74 L64 74" stroke="currentColor" stroke-width="2" opacity=".6" /></symbol>

