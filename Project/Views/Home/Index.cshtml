<div class="marquee" aria-hidden="true">
    <div class="marquee-track">
        <span>🚚 شحن مجاني للطلبات فوق ١٥٠٠ ج.م</span>
        <span>↩︎ إرجاع مجاني خلال ١٤ يوم</span>
        <span>💳 الدفع عند الاستلام متاح</span>
        <span>🚚 شحن مجاني للطلبات فوق ١٥٠٠ ج.م</span>
        <span>↩︎ إرجاع مجاني خلال ١٤ يوم</span>
        <span>💳 الدفع عند الاستلام متاح</span>
    </div>
</div> 

<!-- ============ HERO ============ -->
<section class="hero" id="hero">
    <div class="hero-inner">
        <div>
            <p class="eyebrow">تشكيلة الموسم</p>
            <h1>لبس بيعبّر عنك،<br><em>زي</em> ما إنت عايز.</h1>
            <p>قطع مختارة بعناية لخزانة يومك — من التيشرتات البسيطة لحتة الشتا التقيلة. جودة تدوم، وسعر يرضيك.</p>
            <div class="hero-cta-row">
                <a href="#shop" class="btn">تسوق الآن <svg width="16" height="16"><use href="#ic-plus" /></svg></a>
                <a href="#shop" class="btn ghost" data-navfilter="sale">شوف التخفيضات</a>
            </div>
        </div>
        <div class="hero-visual">
            <div class="hanger-rod"></div>
            <svg class="hanging" viewBox="0 0 100 100" style="color:var(--gold-2)"><use href="#ic-hanger" /></svg>
        </div>
    </div>
</section> 

<!-- ============ SHOP ============ -->
<section class="section" id="shop">
    <div class="wrap">
        <div class="section-head">
            <div>
                <p class="eyebrow">المنتجات</p>
                <h2>اختار اللي يعجبك</h2>
            </div>
            <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;">
                <div class="filters" id="filters">
                    <button class="chip active" data-filter="all">الكل</button>
                    <button class="chip" data-filter="man">رجالي</button>
                    <button class="chip" data-filter="women">حريمي</button>
                    <button class="chip" data-filter="accessories">إكسسوارات</button>
                    <button class="chip" data-filter="sale">تخفيضات</button>
                </div>
                <div class="search-box">
                    <svg><use href="#ic-search" /></svg>
                    <input type="text" id="searchInput" placeholder="دور على منتج...">
                </div>
            </div>
        </div>
        <div class="grid" id="productGrid"></div>
    </div>
</section>

<!-- ============ NEWSLETTER ============ -->
<section class="newsletter">
    <div class="newsletter-inner">
        <div>
            <h2>عايز تعرف الأول؟</h2>
            <p>اشترك في القايمة البريدية وهيوصلك كل جديد وعروض حصرية قبل ما تتنشر.</p>
        </div>
        <form class="news-form" onsubmit="event.preventDefault(); showToast('تم الاشتراك بنجاح 🎉');this.reset();">
            <input type="email" required placeholder="بريدك الإلكتروني">
            <button class="btn" type="submit">اشترك</button>
        </form>
    </div>
</section>

<!-- ============ FOOTER ============ -->
<footer class="site">
    <div class="wrap footer-grid">
        <div>
            <h3>زي</h3>
            <p style="max-width:280px;font-size:.88rem;">ماركة ملابس مصرية، بنصمم لخزانتك اليومية بجودة تستاهل واسعار في متناول اليد.</p>
            <div class="social-row">
                <a href="#" aria-label="انستجرام"><svg><use href="#ic-ig" /></svg></a>
                <a href="#" aria-label="تويتر"><svg><use href="#ic-tw" /></svg></a>
                <a href="#" aria-label="الموقع"><svg><use href="#ic-pin" /></svg></a>
            </div>
        </div>
        <div>
            <h4>تسوق</h4>
            <ul>
                <li><a href="#shop" data-navfilter="man">رجالي</a></li>
                <li><a href="#shop" data-navfilter="women">حريمي</a></li>
                <li><a href="#shop" data-navfilter="accessories">إكسسوارات</a></li>
                <li><a href="#shop" data-navfilter="sale">تخفيضات</a></li>
            </ul>
        </div>
        <div>
            <h4>خدمة العملاء</h4>
            <ul>
                <li><a href="#">تتبع طلبك</a></li>
                <li><a href="#">سياسة الإرجاع</a></li>
                <li><a href="#">الشحن والتوصيل</a></li>
                <li><a href="#">تواصل معنا</a></li>
            </ul>
        </div>
        <div>
            <h4>عن زي</h4>
            <ul>
                <li><a href="#">قصتنا</a></li>
                <li><a href="#">الوظائف</a></li>
                <li><a href="#">الشروط والأحكام</a></li>
            </ul>
        </div>
    </div>
    <div class="foot-bottom">
        <span>© 2026 زي. جميع الحقوق محفوظة.</span>
        <span>صُنع بحب في مصر 🇪🇬</span>
    </div>
</footer>

<!-- ============ CART DRAWER ============ -->
<div class="overlay" id="overlay"></div>
<aside class="cart-drawer" id="cartDrawer" aria-label="سلة المشتريات">
    <div class="cart-head">
        <h2>سلتك</h2>
        <button class="close-btn" id="closeCart" aria-label="اغلاق"><svg><use href="#ic-close" /></svg></button>
    </div>
    <div class="cart-items" id="cartItems"></div>
    <div class="cart-foot" id="cartFoot">
        <div class="sum-row"><span>المجموع الفرعي</span><span id="sumSubtotal">٠ ج.م</span></div>
        <div class="sum-row"><span>الشحن</span><span id="sumShipping">مجاني</span></div>
        <div class="sum-row total"><span>الإجمالي</span><span id="sumTotal">٠ ج.م</span></div>
        <button class="btn checkout-btn" id="checkoutBtn">إتمام الشراء</button>
    </div>
</aside>

<!-- ============ CHECKOUT MODAL ============ -->
<div class="modal-overlay" id="modalOverlay">
    <div class="modal-box">
        <div class="check-circle"><svg><use href="#ic-check" /></svg></div>
        <h3>تم استلام طلبك!</h3>
        <p>هيوصلك تأكيد على بريدك الإلكتروني، وهيتشحن طلبك خلال ٣-٥ أيام عمل.</p>
        <button class="btn" id="modalCloseBtn" style="width:100%;">تمام، يلا نكمل تسوق</button>
    </div>
</div>

<div class="toast-wrap" id="toastWrap"></div>

@section Scripts {
    <script>
        // تمرير البيانات من C# Model إلى دالة الـ JavaScript في site.js
        const serverProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        window.initProducts(serverProducts);
    </script>
}

