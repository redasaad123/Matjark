@{
    ViewData["Title"] = "الإحصائيات والتحليلات";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-6">الإحصائيات والتحليلات</h1>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Charts Section -->
    <div class="row mb-4">
        <!-- Orders by Status -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">توزيع الطلبات حسب الحالة</h5>
                </div>
                <div class="card-body">
                    @if (Model?["OrdersByStatus"] is List<dynamic> ordersByStatus && ordersByStatus.Count > 0)
                    {
                        <canvas id="ordersChart"></canvas>
                        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                        <script>
                            const ctx = document.getElementById('ordersChart').getContext('2d');
                            const data = {
                                labels: [@string.Join(", ", ordersByStatus.Select(x => $"'{x.Status}'"))],
                                datasets: [{
                                    label: 'عدد الطلبات',
                                    data: [@string.Join(", ", ordersByStatus.Select(x => x.Count))],
                                    backgroundColor: [
                                        'rgba(255, 193, 7, 0.5)',
                                        'rgba(76, 175, 80, 0.5)',
                                        'rgba(244, 67, 54, 0.5)',
                                        'rgba(33, 150, 243, 0.5)'
                                    ],
                                    borderColor: [
                                        'rgba(255, 193, 7, 1)',
                                        'rgba(76, 175, 80, 1)',
                                        'rgba(244, 67, 54, 1)',
                                        'rgba(33, 150, 243, 1)'
                                    ],
                                    borderWidth: 1
                                }]
                            };

                            new Chart(ctx, {
                                type: 'doughnut',
                                data: data,
                                options: {
                                    responsive: true,
                                    plugins: {
                                        legend: {
                                            position: 'bottom',
                                        }
                                    }
                                }
                            });
                        </script>
                    }
                </div>
            </div>
        </div>

        <!-- Stock Status -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">منتجات برصيد منخفض</h5>
                </div>
                <div class="card-body">
                    @if (Model?["MissingOrders"] is List<Core.Models.Order> missingOrders && missingOrders.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>رقم الطلب</th>
                                        <th>الحالة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in missingOrders.Take(10))
                                    {
                                        <tr>
                                            <td>@order.Id.Substring(0, 8)...</td>
                                            <td>
                                                <span class="badge bg-danger">منتجات ناقصة</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a href="/order/Index" class="btn btn-sm btn-outline-danger mt-3 w-100">عرض جميع الطلبات</a>
                    }
                    else
                    {
                        <p class="text-success text-center py-4">✓ جميع الطلبات كاملة</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Top Products -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">أفضل المنتجات سعراً</h5>
                </div>
                <div class="card-body">
                    @if (Model?["TopProducts"] is List<Infrastructure.ViewModel.ProductViewModel> topProducts && topProducts.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>اسم المنتج</th>
                                        <th>السعر</th>
                                        <th>الرصيد</th>
                                        <th>الفئة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in topProducts)
                                    {
                                        <tr>
                                            <td>@(topProducts.IndexOf(product) + 1)</td>
                                            <td>@product.Name</td>
                                            <td><strong>₪@product.OldPrice</strong></td>
                                            <td>@product.Quantity</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(product.Cat))
                                                {
                                                    <span class="badge bg-info">@product.Cat</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="row">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">أحدث الطلبات</h5>
                </div>
                <div class="card-body">
                    @if (Model?["RecentOrders"] is List<Core.Models.Order> recentOrders && recentOrders.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>رقم الطلب</th>
                                        <th>العميل</th>
                                        <th>السعر</th>
                                        <th>الحالة</th>
                                        <th>التاريخ</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in recentOrders)
                                    {
                                        <tr>
                                            <td>@(recentOrders.IndexOf(order) + 1)</td>
                                            <td><code>@order.Id.Substring(0, 8)...</code></td>
                                            <td>@order.Customer?.Name</td>
                                            <td><strong>₪@order.TotalPrice</strong></td>
                                            <td>
                                                @if (order.Status.ToString() == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark">قيد الانتظار</span>
                                                }
                                                else if (order.Status.ToString() == "Processed")
                                                {
                                                    <span class="badge bg-success">معالج</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@order.Status</span>
                                                }
                                            </td>
                                            <td>@order.CreatedDate.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <a href="/order/Details/@order.Id" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <a href="/order/Index" class="btn btn-sm btn-outline-info mt-3 w-100">عرض جميع الطلبات</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
