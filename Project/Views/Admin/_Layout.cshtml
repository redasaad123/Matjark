<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة التحكم الإدارية</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <style>
        :root {
            --ink: #20261f;
            --pine: #1f2a24;
            --pine-2: #283a30;
            --paper: #f1ecdf;
            --paper-2: #e7e0cf;
            --gold: #c88a2c;
            --gold-2: #e0a23f;
            --rust: #a63d2f;
            --sage: #7c8577;
            --line: #d8cfb8;
            --radius: 14px;
            --shadow: 0 10px 30px -12px rgba(31,42,36,.35);
            --sidebar-width: 270px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: 'Cairo', sans-serif;
            line-height: 1.6;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .admin-sidebar {
            width: var(--sidebar-width);
            background: linear-gradient(180deg, var(--pine) 0%, var(--pine-2) 100%);
            color: white;
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            box-shadow: var(--shadow);
            z-index: 1000;
            padding: 0;
        }

        .admin-sidebar .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            background: rgba(0, 0, 0, 0.2);
        }

        .admin-sidebar .sidebar-header h4 {
            margin: 0;
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--gold-2);
            font-family: 'El Messiri', serif;
        }

        .admin-sidebar .sidebar-header small {
            opacity: 0.85;
            display: block;
            margin-top: 4px;
            font-size: 0.8rem;
        }

        .admin-sidebar .nav {
            padding: 15px 0;
        }

        .admin-sidebar .nav-item {
            margin: 0;
        }

        .admin-sidebar .nav-link {
            color: rgba(255, 255, 255, 0.8);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            transition: all 0.3s ease;
            border-right: 3px solid transparent;
        }

        .admin-sidebar .nav-link:hover {
            color: var(--gold-2);
            background: rgba(200, 138, 44, 0.1);
            border-right-color: var(--gold-2);
            padding-right: 17px;
        }

        .admin-sidebar .nav-link.active {
            color: var(--gold-2);
            background: rgba(200, 138, 44, 0.15);
            border-right-color: var(--gold-2);
            font-weight: 600;
        }

        .admin-sidebar .nav-link i {
            width: 20px;
            text-align: center;
            font-size: 1.1rem;
        }

        .admin-sidebar .nav-section {
            padding: 15px 20px 8px;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.6;
            color: var(--gold-2);
            margin-top: 8px;
        }

        .admin-sidebar hr {
            margin: 12px 0;
            border-color: rgba(255, 255, 255, 0.1);
        }

        /* Main Content */
        .admin-main {
            margin-left: var(--sidebar-width);
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        /* Top Bar */
        .admin-topbar {
            background: white;
            padding: 15px 30px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--line);
        }

        .admin-topbar .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .admin-topbar .user-name {
            font-size: 0.95rem;
            color: var(--ink);
        }

        .admin-topbar .user-name i {
            color: var(--gold);
            margin-left: 6px;
        }

        .admin-topbar .btn-outline-danger {
            border-color: var(--rust);
            color: var(--rust);
        }

        .admin-topbar .btn-outline-danger:hover {
            background: var(--rust);
            border-color: var(--rust);
        }

        /* Content Area */
        .admin-content {
            padding: 30px;
            flex: 1;
        }

        .admin-content h1 {
            color: var(--pine);
            margin-bottom: 25px;
            font-family: 'El Messiri', serif;
        }

        /* Cards & Tables */
        .card {
            border: 1px solid var(--line);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .card-header {
            background: linear-gradient(90deg, var(--pine) 0%, var(--pine-2) 100%);
            border-bottom: 1px solid var(--line);
            color: white;
        }

        .table-hover tbody tr:hover {
            background: rgba(200, 138, 44, 0.08);
        }

        /* Footer */
        .admin-footer {
            padding: 25px 30px;
            text-align: center;
            color: var(--sage);
            border-top: 1px solid var(--line);
            background: white;
            margin-top: auto;
            font-size: 0.9rem;
        }

        /* Scrollbar */
        .admin-sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .admin-sidebar::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
        }

        .admin-sidebar::-webkit-scrollbar-thumb {
            background: rgba(200, 138, 44, 0.3);
            border-radius: 3px;
        }

        .admin-sidebar::-webkit-scrollbar-thumb:hover {
            background: rgba(200, 138, 44, 0.5);
        }

        /* Responsive */
        @@media screen and (max-width: 768px) {
            :root {
                --sidebar-width: 100%;
            }

            .admin-wrapper {
                flex-direction: column;
            }

            .admin-sidebar {
                position: relative;
                height: auto;
                min-height: auto;
            }

            .admin-main {
                margin-left: 0;
            }

            .admin-topbar {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start;
            }

            .admin-content {
                padding: 15px;
            }
        }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar Navigation -->
        <div class="admin-sidebar">
            <div class="sidebar-header">
                <h4>Matgark Admin</h4>
                <small>لوحة التحكم</small>
            </div>

            <nav class="nav flex-column">
                <a href="/Admin/Dashboard" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="fas fa-chart-line"></i> لوحة التحكم
                </a>

                <div class="nav-section">الإدارة</div>

                <a href="/Manage/Index" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Products" ? "active" : "")">
                    <i class="fas fa-box"></i> المنتجات
                </a>

                <a href="/Category/Index" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Categories" ? "active" : "")">
                    <i class="fas fa-list"></i> الفئات
                </a>

                <a href="/order/Index" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Orders" ? "active" : "")">
                    <i class="fas fa-shopping-cart"></i> الطلبات
                </a>

                <div class="nav-section">التقارير</div>

                <a href="/Admin/Analytics" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Analytics" ? "active" : "")">
                    <i class="fas fa-chart-bar"></i> الإحصائيات
                </a>

                <div style="padding: 15px 20px; margin-top: 30px;">
                    <hr>
                    <a href="/" class="nav-link">
                        <i class="fas fa-arrow-left"></i> العودة للموقع
                    </a>
                </div>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="admin-main">
            <!-- Top Bar -->
            <div class="admin-topbar">
                <div>
                    <span class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("ar-SA"))</span>
                </div>
                <div class="user-info">
                    <span class="user-name">
                        <i class="fas fa-user-circle"></i>
                        @User.Identity?.Name ?? "Admin"
                    </span>
                    <a href="~/Identity/Account/Logout" class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-sign-out-alt"></i> تسجيل خروج
                    </a>
                </div>
            </div>

            <!-- Content -->
            <div class="admin-content">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="admin-footer">
                <p>&copy; 2026 Matgark Admin Dashboard. جميع الحقوق محفوظة.</p>
            </footer>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery (Optional) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
