@{
    ViewData["Title"] = "لوحة التحكم - Admin Dashboard";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">لوحة التحكم الإدارية</h1>
            <p class="text-muted">مرحباً بك في لوحة التحكم الرئيسية</p>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            حدث خطأ ما. يرجى المحاولة مجدداً.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row">
        <!-- Total Products -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #007bff;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">إجمالي المنتجات</p>
                            <h3 class="mb-0">@Model?["TotalProducts"]</h3>
                        </div>
                        <i class="fas fa-box fa-2x text-primary opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-light border-0">
                    <a href="/Manage/Index" class="text-primary small">عرض المنتجات →</a>
                </div>
            </div>
        </div>

        <!-- Total Categories -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #28a745;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">عدد الفئات</p>
                            <h3 class="mb-0">@Model?["TotalCategories"]</h3>
                        </div>
                        <i class="fas fa-list fa-2x text-success opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-light border-0">
                    <a href="/Category/Index" class="text-success small">إدارة الفئات →</a>
                </div>
            </div>
        </div>

        <!-- Total Orders -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ffc107;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">إجمالي الطلبات</p>
                            <h3 class="mb-0">@Model?["TotalOrders"]</h3>
                        </div>
                        <i class="fas fa-shopping-cart fa-2x text-warning opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-light border-0">
                    <a href="/order/Index" class="text-warning small">عرض الطلبات →</a>
                </div>
            </div>
        </div>

        <!-- Low Stock Products -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #dc3545;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">منتجات برصيد منخفض</p>
                            <h3 class="mb-0">@Model?["LowStockProducts"]</h3>
                        </div>
                        <i class="fas fa-exclamation-triangle fa-2x text-danger opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-light border-0">
                    <a href="/Admin/Analytics" class="text-danger small">التفاصيل →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Second Row -->
    <div class="row">
        <!-- Pending Orders -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #17a2b8;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">طلبات قيد الانتظار</p>
                            <h3 class="mb-0">@Model?["PendingOrders"]</h3>
                        </div>
                        <i class="fas fa-hourglass-half fa-2x text-info opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-light border-0">
                    <a href="/order/Index?status=Pending" class="text-info small">عرض التفاصيل →</a>
                </div>
            </div>
        </div>

        <!-- Processed Orders -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #6f42c1;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">طلبات معالجة</p>
                            <h3 class="mb-0">@Model?["ProcessedOrders"]</h3>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-50" style="color: #6f42c1;"></i>
                    </div>
                </div>
                <div class="card-footer bg-light border-0">
                    <a href="/Admin/Orders?status=Processed" class="small" style="color: #6f42c1;">عرض التفاصيل →</a>
                </div>
            </div>
        </div>

        <!-- Total Revenue -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #20c997;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">إجمالي الإيرادات</p>
                            <h3 class="mb-0">₪@Model?["TotalRevenue"]</h3>
                        </div>
                        <i class="fas fa-dollar-sign fa-2x opacity-50" style="color: #20c997;"></i>
                    </div>
                </div>
                <div class="card-footer bg-light border-0">
                    <a href="/Admin/Analytics" class="small" style="color: #20c997;">عرض الإحصائيات →</a>
                </div>
            </div>
        </div>

        <!-- Admin Tools -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #fd7e14;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">أدوات الإدارة</p>
                            <h3 class="mb-0">4</h3>
                        </div>
                        <i class="fas fa-cog fa-2x opacity-50" style="color: #fd7e14;"></i>
                    </div>
                </div>
                <div class="card-footer bg-light border-0">
                    <a href="/Admin/Analytics" class="small" style="color: #fd7e14;">الإحصائيات →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-5">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light border-0">
                    <h5 class="mb-0">إجراءات سريعة</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a href="/Manage/AddProducts" class="btn btn-primary w-100">
                                <i class="fas fa-plus"></i> إضافة منتج جديد
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="/Category/AddCategory" class="btn btn-success w-100">
                                <i class="fas fa-plus"></i> إضافة فئة جديدة
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="/order/Index" class="btn btn-warning w-100">
                                <i class="fas fa-eye"></i> عرض الطلبات
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a href="/Admin/Analytics" class="btn btn-info w-100">
                                <i class="fas fa-chart-bar"></i> الإحصائيات
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
    }

    .card-footer a {
        text-decoration: none;
        font-weight: 500;
    }

    .card-footer a:hover {
        text-decoration: underline;
    }
</style>
